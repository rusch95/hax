/-
Hax Lean Backend - Cryspen

Formal specification for floating-point arithmetic based on:
"A Formal Approach to Floating Point" by Daumas, Rideau, and Théry (NASA)

This module provides the formal semantics connecting floating-point
operations to rational number approximations, following IEEE 754 principles.

Note: We use Rat (rationals) as the mathematical model instead of reals,
which is sufficient for specifying error bounds and is computationally tractable.
-/

import Hax.Lib

/-!
# Floating Point Format

A floating-point format is characterized by:
- β (beta): the radix (base), typically 2
- p: the precision (number of significant digits)
- emin, emax: minimum and maximum exponents

A finite float is represented as: ±m × β^e where:
- m is the mantissa with p digits: m = d₀.d₁d₂...d_{p-1}
- e is the exponent with emin ≤ e ≤ emax
-/

namespace Float.Spec

/-- Rounding modes as defined in IEEE 754 -/
inductive RoundingMode where
  | ToNearest : RoundingMode      -- Round to nearest, ties to even
  | ToZero : RoundingMode          -- Round toward zero (truncation)
  | TowardPositive : RoundingMode  -- Round toward +∞
  | TowardNegative : RoundingMode  -- Round toward -∞
  deriving Repr, BEq, DecidableEq

open RoundingMode

/-- Floating-point format parameters -/
structure FloatFormat where
  β : Nat           -- radix (base), typically 2
  p : Nat           -- precision (number of significant digits)
  emin : Int        -- minimum exponent
  emax : Int        -- maximum exponent
  β_ge_2 : β ≥ 2
  p_pos : p > 0
  exp_range : emin < emax

/-- IEEE 754 binary32 (f32) format -/
def binary32 : FloatFormat where
  β := 2
  p := 24
  emin := -126
  emax := 127
  β_ge_2 := by decide
  p_pos := by decide
  exp_range := by decide

/-- IEEE 754 binary64 (f64) format -/
def binary64 : FloatFormat where
  β := 2
  p := 53
  emin := -1022
  emax := 1023
  β_ge_2 := by decide
  p_pos := by decide
  exp_range := by decide

/-!
# Representable Numbers and ULP

A rational number is representable in format fmt if it can be exactly
expressed as ±m × β^e with the format constraints.

The unit in the last place (ulp) measures the gap between consecutive
representable numbers.
-/

/-- The ulp (unit in last place) at a given exponent -/
def ulp (fmt : FloatFormat) (e : Int) : Rat :=
  (fmt.β : Rat) ^ (e - (fmt.p - 1 : Nat))

/-- Relative precision of the format (machine epsilon / 2) -/
def eta (fmt : FloatFormat) : Rat :=
  (fmt.β : Rat) ^ (-(fmt.p - 1 : Nat) : Int)

/-- Maximum representable finite value (as rational approximation) -/
def maxFinite (fmt : FloatFormat) : Rat :=
  ((fmt.β : Rat) ^ fmt.p - 1) * (fmt.β : Rat) ^ (fmt.emax - (fmt.p - 1 : Nat))

/-- Minimum positive normalized value -/
def minNormal (fmt : FloatFormat) : Rat :=
  (fmt.β : Rat) ^ fmt.emin

/-!
# Rounding Function

The rounding function maps rationals to their floating-point approximation
according to a rounding mode.

## Axioms (from NASA paper Section 2.2)

The rounding function satisfies these fundamental properties:
-/

/-- Abstract rounding function from rationals to rationals (representing floats) -/
axiom round : FloatFormat → RoundingMode → Rat → Rat

/-- Axiom: Rounding is monotonic -/
axiom round_monotonic (fmt : FloatFormat) (mode : RoundingMode) :
  ∀ x y : Rat, x ≤ y → round fmt mode x ≤ round fmt mode y

/-- Axiom: Rounding is idempotent -/
axiom round_idempotent (fmt : FloatFormat) (mode : RoundingMode) :
  ∀ x : Rat, round fmt mode (round fmt mode x) = round fmt mode x

/-- Axiom: Rounding respects zero -/
axiom round_zero (fmt : FloatFormat) (mode : RoundingMode) :
  round fmt mode 0 = 0

/-- Axiom: Rounding respects negation -/
axiom round_neg (fmt : FloatFormat) (mode : RoundingMode) :
  ∀ x : Rat, round fmt mode (-x) = -(round fmt mode x)

/-- Absolute value for rationals -/
def abs_rat (x : Rat) : Rat := if x < 0 then -x else x

/-- Axiom: Bounded relative error for RoundToNearest (Theorem 2.1 in paper) -/
axiom round_nearest_error (fmt : FloatFormat) :
  ∀ x : Rat, abs_rat x ≤ maxFinite fmt →
    abs_rat (round fmt ToNearest x - x) ≤ eta fmt * abs_rat x

/-- Axiom: Bounded absolute error for RoundToNearest -/
axiom round_nearest_error_abs (fmt : FloatFormat) :
  ∀ x : Rat, ∀ e : Int, fmt.emin ≤ e → e ≤ fmt.emax →
    (fmt.β : Rat) ^ e ≤ abs_rat x → abs_rat x < (fmt.β : Rat) ^ (e + 1) →
    abs_rat (round fmt ToNearest x - x) ≤ ulp fmt e / 2

/-- Axiom: RoundToZero rounds toward zero -/
axiom round_toward_zero_spec (fmt : FloatFormat) :
  ∀ x : Rat, abs_rat (round fmt ToZero x) ≤ abs_rat x

/-- Axiom: TowardPositive rounds up -/
axiom round_toward_positive_spec (fmt : FloatFormat) :
  ∀ x : Rat, round fmt TowardPositive x ≥ x

/-- Axiom: TowardNegative rounds down -/
axiom round_toward_negative_spec (fmt : FloatFormat) :
  ∀ x : Rat, round fmt TowardNegative x ≤ x

/-!
# Floating-Point Operations

Operations are defined as: fl_op(x, y) = round(x op y)
where op is the exact rational operation.

The key theorem is that each operation has bounded error.
-/

/-- Floating-point addition -/
noncomputable def fl_add (fmt : FloatFormat) (mode : RoundingMode) (x y : Rat) : Rat :=
  round fmt mode (x + y)

/-- Floating-point subtraction -/
noncomputable def fl_sub (fmt : FloatFormat) (mode : RoundingMode) (x y : Rat) : Rat :=
  round fmt mode (x - y)

/-- Floating-point multiplication -/
noncomputable def fl_mul (fmt : FloatFormat) (mode : RoundingMode) (x y : Rat) : Rat :=
  round fmt mode (x * y)

/-- Floating-point division -/
noncomputable def fl_div (fmt : FloatFormat) (mode : RoundingMode) (x y : Rat) : Rat :=
  round fmt mode (x / y)

/-!
# Error Bounds for Operations (Theorem 3.1 in paper)

Each correctly rounded operation has relative error bounded by η (eta).
-/

theorem fl_add_error (fmt : FloatFormat) (x y : Rat) :
  abs_rat (x + y) ≤ maxFinite fmt →
  abs_rat (fl_add fmt ToNearest x y - (x + y)) ≤ eta fmt * abs_rat (x + y) := by
  intro h
  unfold fl_add
  exact round_nearest_error fmt (x + y) h

theorem fl_sub_error (fmt : FloatFormat) (x y : Rat) :
  abs_rat (x - y) ≤ maxFinite fmt →
  abs_rat (fl_sub fmt ToNearest x y - (x - y)) ≤ eta fmt * abs_rat (x - y) := by
  intro h
  unfold fl_sub
  exact round_nearest_error fmt (x - y) h

theorem fl_mul_error (fmt : FloatFormat) (x y : Rat) :
  abs_rat (x * y) ≤ maxFinite fmt →
  abs_rat (fl_mul fmt ToNearest x y - (x * y)) ≤ eta fmt * abs_rat (x * y) := by
  intro h
  unfold fl_mul
  exact round_nearest_error fmt (x * y) h

theorem fl_div_error (fmt : FloatFormat) (x y : Rat) :
  y ≠ 0 → abs_rat (x / y) ≤ maxFinite fmt →
  abs_rat (fl_div fmt ToNearest x y - (x / y)) ≤ eta fmt * abs_rat (x / y) := by
  intro _ h
  unfold fl_div
  exact round_nearest_error fmt (x / y) h

/-!
# Sterbenz Lemma (Theorem 4.3 in paper)

Subtraction is exact when operands are close enough.
-/

axiom sterbenz_lemma (fmt : FloatFormat) (x y : Rat) :
  round fmt ToNearest x = x →
  round fmt ToNearest y = y →
  y / 2 ≤ x → x ≤ 2 * y →
  round fmt ToNearest (x - y) = x - y

/-!
# Monotonicity Properties
-/

theorem fl_add_monotonic_left (fmt : FloatFormat) (mode : RoundingMode) (x y z : Rat) :
  x ≤ y →
  fl_add fmt mode x z ≤ fl_add fmt mode y z := by
  intro h
  unfold fl_add
  apply round_monotonic
  linarith

theorem fl_mul_monotonic_nonneg (fmt : FloatFormat) (mode : RoundingMode) (x y z : Rat) :
  0 ≤ z → x ≤ y →
  fl_mul fmt mode x z ≤ fl_mul fmt mode y z := by
  intro hz h
  unfold fl_mul
  apply round_monotonic
  have : x * z ≤ y * z := Rat.mul_le_mul_of_nonneg_right h hz
  exact this

/-!
# Connecting to Lean's Float Types

We axiomatize the connection between Lean's concrete Float32/Float types
and our abstract specification.
-/

/-- Abstract embedding from Float32 to Rat -/
axiom f32_to_rat : Float32 → Rat

/-- Abstract embedding from Float (f64) to Rat -/
axiom f64_to_rat : Float → Rat

/-- Axiom: Float32 operations follow the binary32 spec -/
axiom f32_add_spec (x y : Float32) :
  f32_to_rat (x + y) = fl_add binary32 ToNearest (f32_to_rat x) (f32_to_rat y)

axiom f32_sub_spec (x y : Float32) :
  f32_to_rat (x - y) = fl_sub binary32 ToNearest (f32_to_rat x) (f32_to_rat y)

axiom f32_mul_spec (x y : Float32) :
  f32_to_rat (x * y) = fl_mul binary32 ToNearest (f32_to_rat x) (f32_to_rat y)

axiom f32_div_spec (x y : Float32) :
  f32_to_rat (x / y) = fl_div binary32 ToNearest (f32_to_rat x) (f32_to_rat y)

/-- Axiom: Float (f64) operations follow the binary64 spec -/
axiom f64_add_spec (x y : Float) :
  f64_to_rat (x + y) = fl_add binary64 ToNearest (f64_to_rat x) (f64_to_rat y)

axiom f64_sub_spec (x y : Float) :
  f64_to_rat (x - y) = fl_sub binary64 ToNearest (f64_to_rat x) (f64_to_rat y)

axiom f64_mul_spec (x y : Float) :
  f64_to_rat (x * y) = fl_mul binary64 ToNearest (f64_to_rat x) (f64_to_rat y)

axiom f64_div_spec (x y : Float) :
  f64_to_rat (x / y) = fl_div binary64 ToNearest (f64_to_rat x) (f64_to_rat y)

/-!
# Useful Derived Properties

These are consequences of the axioms that are commonly needed.
-/

/-- Machine epsilon for binary32 (approximately 1.19e-7) -/
def epsilon_f32 : Rat := eta binary32

/-- Machine epsilon for binary64 (approximately 2.22e-16) -/
def epsilon_f64 : Rat := eta binary64

/-- Error bound for f32 addition in terms of epsilon -/
theorem f32_add_error_bound (x y : Float32) :
  let result := f32_to_rat (x + y)
  let exact := f32_to_rat x + f32_to_rat y
  abs_rat exact ≤ maxFinite binary32 →
  abs_rat (result - exact) ≤ epsilon_f32 * abs_rat exact := by
  intro result exact h
  rw [f32_add_spec]
  unfold fl_add epsilon_f32
  exact round_nearest_error binary32 exact h

/-- Error bound for f64 multiplication -/
theorem f64_mul_error_bound (x y : Float) :
  let result := f64_to_rat (x * y)
  let exact := f64_to_rat x * f64_to_rat y
  abs_rat exact ≤ maxFinite binary64 →
  abs_rat (result - exact) ≤ epsilon_f64 * abs_rat exact := by
  intro result exact h
  rw [f64_mul_spec]
  unfold fl_mul epsilon_f64
  exact round_nearest_error binary64 exact h

end Float.Spec

